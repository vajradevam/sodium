// ── Void return from function ──
function do_nothing() {
    return;       // void return (no parens)
}

// ── Const in global size ──
const ARR_SIZE = 5;


function main() {
    var ok = 1;
    {}
    if (1 == 1) {}
    if (0 == 1) {} else {}
    var i = 0;
    while (i < 5) {
        i = i + 1;
    }
    if (i != 5) { ok = 0; }
    var dw_done = 0;
    do {
        dw_done = 1;
    } while (0 == 1);   // executes once, condition false, exits
    if (dw_done != 1) { ok = 0; }
    var f_sum = 0;
    for (var fi = 0; fi < 5; fi = fi + 1) {
        f_sum = f_sum + fi;
    }
    if (f_sum != 10) { ok = 0; }  // 0+1+2+3+4 = 10
    var sw_val = 0;
    switch(2) {
        case 1:
        case 2:
            sw_val = 42;
        case 3:
    }
    if (sw_val != 42) { ok = 0; }
    var br_val = 0;
    while (1 == 1) {
        br_val = 7;
        break;
    }
    if (br_val != 7) { ok = 0; }
    do_nothing();
    var arr[ARR_SIZE];
    arr[0] = 10;
    arr[4] = 50;
    if (arr[0] != 10) { ok = 0; }
    if (arr[4] != 50) { ok = 0; }
    return(ok);
}
