// EXPECT-EXIT: 0
// EXPECT-STDOUT: 4950 100
// EXPECT-STDOUT: 125

// O0: loops with calls and register pressure must keep loop-carried values
// intact. The runner executes this at -O0 and the -O1 suite runs it again.

function one() -> i64 {
    return 1;
}

function main() {
    var sum = 0;
    var i = 0;
    while (i < 100) {
        var step = one();
        sum = sum + i;
        i = i + step;
    }
    print("%d %d", sum, i);

    var total = 0;
    var a = 0;
    while (a < 5) {
        var b = 0;
        while (b < 5) {
            total = total + one() + a + b;
            b = b + 1;
        }
        a = a + 1;
    }
    print("%d", total);
    return 0;
}
