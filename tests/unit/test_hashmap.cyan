// EXPECT-EXIT: 0
// EXPECT-STDOUT: map ok

// Property test for the string->i64 hash map: 40 random keys inserted and
// overwritten, then verified against a reference array and an order-independent
// checksum, followed by random removals.
#include "containers.cyan"
#include "fmt.cyan"

global var g_seed = 987654321;

function rnd() -> i64 {
    g_seed = (g_seed * 1103515245 + 12345) & 0x7fffffff;
    return(g_seed);
}

function key_of(i: i64, buf: u8*) -> u8* {
    *buf = 107;  // 'k'
    if (itoa(buf + 1, i) == null) { return(null); }
    return(buf);
}

function main() {
    var m: Map;
    map_init(&m, 16);
    var ref: i64[64];
    var key: u8[16];
    var i = 0;
    while (i < 40) { ref[i] = -1; i = i + 1; }

    i = 0;
    while (i < 40) {
        var idx = rnd() % 40;
        var val = rnd() % 1000;
        map_put(&m, key_of(idx, key), val);
        ref[idx] = val;
        i = i + 1;
    }
    var distinct = 0;
    i = 0;
    while (i < 40) {
        if (ref[i] != -1) { distinct = distinct + 1; }
        i = i + 1;
    }
    if (map_count(&m) != distinct) { return(1); }

    i = 0;
    while (i < 40) {
        if (ref[i] != -1) {
            if (map_contains(&m, key_of(i, key)) != 1) { return(2); }
            if (map_get(&m, key_of(i, key)) != ref[i]) { return(3); }
        }
        i = i + 1;
    }

    var expected = 0;
    i = 0;
    while (i < 40) {
        if (ref[i] != -1) {
            expected = expected + (map_hash(key_of(i, key)) & 0xffff) + ref[i];
        }
        i = i + 1;
    }
    if (map_checksum(&m) != expected) { return(4); }

    var removed_idx = -1;
    i = 0;
    while (i < 15) {
        var idx = rnd() % 40;
        if (ref[idx] != -1) {
            map_remove(&m, key_of(idx, key));
            ref[idx] = -1;
            removed_idx = idx;
        }
        i = i + 1;
    }
    expected = 0;
    var live = 0;
    i = 0;
    while (i < 40) {
        var present = map_contains(&m, key_of(i, key));
        if (present != 0 && ref[i] == -1) { return(5); }
        if (present == 0 && ref[i] != -1) { return(6); }
        if (present != 0) {
            expected = expected + (map_hash(key_of(i, key)) & 0xffff) + ref[i];
            live = live + 1;
        }
        i = i + 1;
    }
    if (map_checksum(&m) != expected) { return(7); }
    if (map_count(&m) != live) { return(8); }

    if (removed_idx >= 0) {
        map_put(&m, key_of(removed_idx, key), 999);
        if (map_count(&m) != live + 1) { return(9); }
        if (map_get(&m, key_of(removed_idx, key)) != 999) { return(10); }
    }

    map_free(&m);
    print("map ok");
    return(0);
}
