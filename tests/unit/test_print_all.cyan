// EXPECT-EXIT: 0

// Comprehensive test for unified print with C-style format strings
// Run this and visually verify the output.

// ── 1. print("plain string") ─────────────────────────────────────────────

// ── 2. print(42) — backward compat integer ──────────────────────────────

// ── 3. print() — just newline ──────────────────────────────────────────

// ── 4. print("%d", x) — single integer ─────────────────────────────────

// ── 5. print("%s", strlit) — string literal ────────────────────────────

// ── 6. Multiple args ────────────────────────────────────────────────────

// ── 7. Expression in arg ────────────────────────────────────────────────

// ── 8. %% — literal percent ─────────────────────────────────────────────

// ── 9. Variables as args ────────────────────────────────────────────────

// ── 10. Mixed text and format ───────────────────────────────────────────

// ── 11. Backward compat: print variable (non-string) ───────────────────

// ── 12. Function call in arg ───────────────────────────────────────────
function double(n) { return n * 2; }

// ── 13. Long format string ─────────────────────────────────────────────

// ── 14. Format with no placeholders (just text) ────────────────────────

// ── 15. Consecutive %% ─────────────────────────────────────────────────

// ── 16. Zero value ─────────────────────────────────────────────────────

// ── 17. Edge cases ─────────────────────────────────────────────────────

// ── 18. Mixed %%d and %%s ───────────────────────────────────────────────

// ── 19. Multiple %%s ────────────────────────────────────────────────────

// ── 20. No newline test (just content) ─────────────────────────────────

// ── 21. All done ───────────────────────────────────────────────────────


function main() {
    print("=== 1. plain string ===");
    print("hello world");
    print("=== 2. backward compat integer ===");
    print(42);
    print(-42);
    print("=== 3. empty print() ===");
    print();
    print("above was empty line");
    print("=== 4. %%d format ===");
    print("%d", 42);
    print("%d", -42);
    print("=== 5. %%s with string literal ===");
    print("%s", "hi");
    print("prefix %s suffix", "hello");
    print("=== 6. multiple arguments ===");
    print("%d %d %d", 10, 20, 30);
    print("a=%d b=%d c=%d", 1, 2, 3);
    print("=== 7. expressions ===");
    print("sum=%d", 10 + 20);
    print("mul=%d", 6 * 7);
    print("neg=%d", -100);
    print("=== 8. literal percent ===");
    print("100%%");
    print("%d%%", 50);
    print("%d%% of %d", 75, 200);
    print("=== 9. variables ===");
    var x = 100;
    var y = 200;
    print("x=%d y=%d", x, y);
    print("x+y=%d", x + y);
    print("=== 10. mixed ===");
    print("The answer is %d", 42);
    print("%d + %d = %d", 2, 3, 2 + 3);
    print("=== 11. backward compat variable ===");
    var val = 77;
    print(val);
    print("=== 12. function calls ===");
    print("double(21)=%d", double(21));
    print("=== 13. long format ===");
    print("nums: %d %d %d %d %d %d %d %d", 1, 2, 3, 4, 5, 6, 7, 8);
    print("=== 14. no placeholders ===");
    print("just text no placeholders");
    print("=== 15. consecutive percent ===");
    print("%%%%");
    print("%d%%%d%%", 50, 75);
    print("=== 16. zero ===");
    print("%d", 0);
    print("=== 17. edge cases ===");
    print("%d", -1);
    print("%d", -999);
    print("%d", 2147483647);
    print("%d", -2147483647);
    print("=== 18. mixed %%d and %%s ===");
    print("Hello %s, you are %d years old", "Alice", 30);
    print("=== 19. multiple %%s ===");
    print("%s %s %s", "a", "b", "c");
    print("=== 20. no extra newlines ===");
    print("first");
    print("second");
    print("third");
    print("=== 21. done ===");
    print("All print tests completed!");
    return 0;
}
