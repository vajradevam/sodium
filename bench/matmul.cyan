// Dense integer matrix multiply — nested loops and indexed loads.
// EXPECT-EXIT: 0
// EXPECT-STDOUT: 72976

function main() {
    var a[64];
    var b[64];
    var c[64];
    var i = 0;
    while (i < 64) {
        a[i] = i + 1;
        b[i] = i + 1;
        c[i] = 0;
        i = i + 1;
    }
    i = 0;
    while (i < 8) {
        var j = 0;
        while (j < 8) {
            var sum = 0;
            var k = 0;
            while (k < 8) {
                sum = sum + a[i * 8 + k] * b[k * 8 + j];
                k = k + 1;
            }
            c[i * 8 + j] = sum;
            j = j + 1;
        }
        i = i + 1;
    }
    // Trace of C (not mathematically meaningful, but a stable checksum).
    var trace = 0;
    i = 0;
    while (i < 8) { trace = trace + c[i * 8 + i]; i = i + 1; }
    print("%d", trace);
    return 0;
}
