// COMPILE-FLAGS: --stack-probe
// EXPECT-EXIT: 0
// EXPECT-STDOUT: 55

// X4c: shallow recursion must be unaffected by the stack probe.

function down(n: i64) -> i64 {
    var pad[16];
    pad[0] = n;
    if (n == 0) { return pad[0]; }
    return down(n - 1) + pad[0];
}

function main() {
    print("%d", down(10));
    return 0;
}
