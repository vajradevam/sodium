// C-interop (D-012, Y8b4b): a gcc-compiled C `main` calls these Cyan functions with C
// structs and checks every result. scripts/test_abi_interop.sh weakens this file's
// `main` so the C one wins; run on its own, this program just exits 0.
// SKIP-TEST: part of scripts/test_abi_interop.sh (needs the C object)

struct T1 { var a: i8; };
struct T3 { var a: i8; var b: i8; var c: i8; };
struct T6 { var a: i16; var b: i16; var c: i16; };
struct T8 { var a: i32; var b: i32; };
struct T12 { var a: i32; var b: i32; var c: i32; };
struct T16 { var a: i64; var b: i64; };
struct T24 { var a: i64; var b: i64; var c: i64; };
struct T40 { var a: i64; var b: i64; var c: i64; var d: i64; var e: i64; };
struct TM { var a: i8; var b: i64; var c: i16; };

function sum_T1(s: T1) -> i64 { return s.a * 1; }
function make_T1(a: i8) -> T1 {
    var r: T1;
    r.a = a;
    return r;
}
function sum_T3(s: T3) -> i64 { return s.a * 1 + s.b * 10 + s.c * 100; }
function make_T3(a: i8, b: i8, c: i8) -> T3 {
    var r: T3;
    r.a = a;
    r.b = b;
    r.c = c;
    return r;
}
function sum_T6(s: T6) -> i64 { return s.a * 1 + s.b * 10 + s.c * 100; }
function make_T6(a: i16, b: i16, c: i16) -> T6 {
    var r: T6;
    r.a = a;
    r.b = b;
    r.c = c;
    return r;
}
function sum_T8(s: T8) -> i64 { return s.a * 1 + s.b * 10; }
function make_T8(a: i32, b: i32) -> T8 {
    var r: T8;
    r.a = a;
    r.b = b;
    return r;
}
function sum_T12(s: T12) -> i64 { return s.a * 1 + s.b * 10 + s.c * 100; }
function make_T12(a: i32, b: i32, c: i32) -> T12 {
    var r: T12;
    r.a = a;
    r.b = b;
    r.c = c;
    return r;
}
function sum_T16(s: T16) -> i64 { return s.a * 1 + s.b * 10; }
function make_T16(a: i64, b: i64) -> T16 {
    var r: T16;
    r.a = a;
    r.b = b;
    return r;
}
function sum_T24(s: T24) -> i64 { return s.a * 1 + s.b * 10 + s.c * 100; }
function make_T24(a: i64, b: i64, c: i64) -> T24 {
    var r: T24;
    r.a = a;
    r.b = b;
    r.c = c;
    return r;
}
function sum_T40(s: T40) -> i64 { return s.a * 1 + s.b * 10 + s.c * 100 + s.d * 1000 + s.e * 10000; }
function make_T40(a: i64, b: i64, c: i64, d: i64, e: i64) -> T40 {
    var r: T40;
    r.a = a;
    r.b = b;
    r.c = c;
    r.d = d;
    r.e = e;
    return r;
}
function sum_TM(s: TM) -> i64 { return s.a * 1 + s.b * 10 + s.c * 100; }
function make_TM(a: i8, b: i64, c: i16) -> TM {
    var r: TM;
    r.a = a;
    r.b = b;
    r.c = c;
    return r;
}
function pos_mix(x: i64, p: T16, y: i64, q: T24, z: i64) -> i64 { return x + p.a * 10 + p.b * 100 + y * 1000 + q.a * 10000 + q.b * 100000 + q.c * 1000000 + z * 10000000; }
function backfill(a: i64, b: i64, c: i64, d: i64, e: i64, p: T16, g: i64) -> i64 { return a + b * 10 + c * 100 + d * 1000 + e * 10000 + p.a * 100000 + p.b * 1000000 + g * 10000000; }
function straddle7(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64, p: T16) -> i64 { return a + b * 10 + c * 100 + d * 1000 + e * 10000 + f * 100000 + g * 1000000 + p.a * 10000000 + p.b * 100000000; }
function small_mix(p: T3, q: T6, r: T12, s: T8) -> i64 { return p.a + p.b * 2 + p.c * 3 + q.a * 4 + q.b * 5 + q.c * 6 + r.a * 7 + r.b * 8 + r.c * 9 + s.a * 10 + s.b * 11; }
function big_two(p: T40, q: T40, k: i64) -> i64 { return p.a + p.e * 10 + q.a * 100 + q.e * 1000 + k * 10000 + p.c * 100000 + q.c * 1000000; }
function mem_mixed(m: TM, x: i64, n: TM) -> i64 { return m.a + m.b * 10 + m.c * 100 + x * 1000 + n.a * 10000 + n.b * 100000 + n.c * 1000000; }
function relay16(p: T16) -> T16 {
    var r: T16;
    r.a = p.b + 7;
    r.b = p.a + 7;
    return r;
}
function relay24(p: T24) -> T24 {
    var r: T24;
    r.a = p.a + 7;
    r.b = p.b + 7;
    r.c = p.c + 7;
    return r;
}
function relay40(p: T40) -> T40 {
    var r: T40;
    r.a = p.e;
    r.b = p.d;
    r.c = p.c;
    r.d = p.b;
    r.e = p.a;
    return r;
}
function relay12(p: T12) -> T12 {
    var r: T12;
    r.a = p.b;
    r.b = p.c;
    r.c = p.a;
    return r;
}
function relay3(p: T3) -> T3 {
    var r: T3;
    r.a = p.c;
    r.b = p.b;
    r.c = p.a;
    return r;
}
function relay8(p: T8) -> T8 {
    var r: T8;
    r.a = p.b + 7;
    r.b = p.a + 7;
    return r;
}
function relaym(p: TM) -> TM {
    var r: TM;
    r.a = p.c;
    r.b = p.b + 7;
    r.c = p.a;
    return r;
}

function main() { return(0); }
