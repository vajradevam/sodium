// T-3: precedence and associativity of every operator family. Each value was
// cross-checked against a gcc-compiled C program with the same expressions.
// EXPECT-EXIT: 0
// EXPECT-STDOUT: 7
// EXPECT-STDOUT: 9
// EXPECT-STDOUT: 3
// EXPECT-STDOUT: 1
// EXPECT-STDOUT: 2
// EXPECT-STDOUT: 3
// EXPECT-STDOUT: 0
// EXPECT-STDOUT: 0
// EXPECT-STDOUT: 1
// EXPECT-STDOUT: 3
// EXPECT-STDOUT: -6
// EXPECT-STDOUT: 1
// EXPECT-STDOUT: 15
// EXPECT-STDOUT: 64
// EXPECT-STDOUT: 5
// EXPECT-STDOUT: 12

function main() {
    print(1 + 2 * 3);
    print((1 + 2) * 3);
    print(8 - 3 - 2);
    print(2 * 3 / 4);
    print(16 >> 2 + 1);
    print(1 | 2 & 3);
    print(1 ^ 3 & 1);
    print(0 || 0 && 0);
    print(1 == 2 < 3);
    print(0 ? 1 : 2 ? 3 : 4);
    print(-2 * 3);
    print(!0 == 1);
    print(~0 & 15);
    print(1 << 2 * 3);
    print(100 / 10 / 2);
    print(2 + 3 * 4 - 5 / 2);
    return(0);
}
