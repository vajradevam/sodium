// EXPECT-EXIT: 0
// EXPECT-STDOUT: 3.375000
// EXPECT-STDOUT: 1.687500
// EXPECT-STDOUT: 1.750000
// EXPECT-STDOUT: 4.500000
// EXPECT-STDOUT: 0.100000
// EXPECT-STDOUT: 16777216.000000
// EXPECT-STDOUT: 3.000000
function half(x: f32) -> f32 {
    return x / 2.0f;
}

function main() {
    var a: f32 = 1.5f;
    var b: f32 = 2.25f;
    var c: f32 = a * b;
    print("%f", c);
    print(half(c));
    var d: f64 = a;
    print(d + 0.25);
    var e: f32 = (d * 3.0) as f32;
    print(e);
    var tenth: f32 = 0.1f;
    var wide: f64 = tenth;
    print(wide);
    var big: f64 = 16777217.0;
    var narrowed: f32 = big as f32;
    print(narrowed);
    var n: f32 = 3;
    print(n);
    return(0);
}
