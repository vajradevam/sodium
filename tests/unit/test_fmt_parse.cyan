// EXPECT-EXIT: 0
// EXPECT-STDOUT: 0 12345
// EXPECT-STDOUT: 0 -42
// EXPECT-STDOUT: 0 7
// EXPECT-STDOUT: 0 255
// EXPECT-STDOUT: 0 42
// EXPECT-STDOUT: 0 35
// EXPECT-STDOUT: 1 0
// EXPECT-STDOUT: 1 0
// EXPECT-STDOUT: 2 0
// EXPECT-STDOUT: 2 0
// EXPECT-STDOUT: 0 9223372036854775807
// EXPECT-STDOUT: 3 0
// EXPECT-STDOUT: 0 -9223372036854775808
// EXPECT-STDOUT: 3 0
// EXPECT-STDOUT: 3 0
// EXPECT-STDOUT: 0 -9223372036854775808
// EXPECT-STDOUT: 4 0
// EXPECT-STDOUT: 4 0
// EXPECT-STDOUT: ok
// EXPECT-STDOUT: overflow
// EXPECT-STDOUT: 0 42

// string-to-int with explicit status: 0 ok, 1 empty, 2 invalid digit,
// 3 overflow, 4 invalid base. Covers signs, every base and i64 boundaries.
#include "fmt.cyan"

function show(s: u8*, base: i64) {
    var r: ParseInt = str_to_i64(s, base);
    print("%d %d", r.status, r.value);
    return(0);
}

function main() {
    show("12345", 10);
    show("-42", 10);
    show("+7", 10);
    show("ff", 16);
    show("101010", 2);
    show("z", 36);
    show("", 10);
    show("-", 10);
    show("12x", 10);
    show("2", 2);
    show("9223372036854775807", 10);
    show("9223372036854775808", 10);
    show("-9223372036854775808", 10);
    show("-9223372036854775809", 10);
    show("8000000000000000", 16);
    show("-8000000000000000", 16);
    show("1", 1);
    show("1", 37);
    print("%s", parse_status_name(0));
    print("%s", parse_status_name(3));
    var a: ParseInt = atoi("42");
    print("%d %d", a.status, a.value);
    return(0);
}
