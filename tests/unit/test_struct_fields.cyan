struct Point {
    var x;
    var y;
};

// Test field access in various expression contexts

// Field in arithmetic

// Field comparison

// Field in ternary

// Field in function call
function double_it(v) {
    return(v * 2);
}

// Multiple field accesses in one expression

// Assign field value to regular var


function main() {
    var p: Point;
    p.x = 5;
    p.y = 10;
    var a = p.x + p.y;
    print(a);
    var cmp = p.x < p.y;
    print(cmp);
    var t = p.x > 0 ? p.x : 0;
    print(t);
    var doubled = double_it(p.y);
    print(doubled);
    var combined = p.x * 3 + p.y * 2;
    print(combined);
    var tmp = p.x;
    p.x = p.y;
    p.y = tmp;
    print(p.x);
    print(p.y);
    return(a + cmp + t + doubled + combined + p.x + p.y);
}
