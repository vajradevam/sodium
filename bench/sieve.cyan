// Sieve of Eratosthenes — array writes and nested loops.
// EXPECT-EXIT: 0
// EXPECT-STDOUT: 46

function main() {
    var prime[200];
    var i = 0;
    while (i < 200) { prime[i] = 1; i = i + 1; }
    prime[0] = 0;
    prime[1] = 0;
    var p = 2;
    while (p * p < 200) {
        if (prime[p] == 1) {
            var m = p * p;
            while (m < 200) { prime[m] = 0; m = m + p; }
        }
        p = p + 1;
    }
    var count = 0;
    i = 0;
    while (i < 200) {
        count = count + prime[i];
        i = i + 1;
    }
    print("%d", count);
    return 0;
}
