// Bubble sort — branches, swaps and repeated array access.
// EXPECT-EXIT: 0
// EXPECT-STDOUT: 331284

function main() {
    var a[100];
    var i = 0;
    while (i < 100) { a[i] = (i * 37) % 101; i = i + 1; }
    i = 0;
    while (i < 100) {
        var j = 0;
        while (j < 99 - i) {
            if (a[j] > a[j + 1]) {
                var t = a[j];
                a[j] = a[j + 1];
                a[j + 1] = t;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    var sum = 0;
    i = 0;
    while (i < 100) { sum = sum + a[i] * i; i = i + 1; }
    print("%d", sum);
    return 0;
}
