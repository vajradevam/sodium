// EXPECT-EXIT: 0

// V10/V11: a stack frame larger than 2 MiB. riscv64 calls now use
// auipc+jalr, so they no longer exceed JAL's +-1 MiB range.

function main() {
    var a[300000];
    a[0] = 1;
    a[150000] = 2;
    a[299999] = 3;
    if (a[0] != 1) { return(1); }
    if (a[150000] != 2) { return(2); }
    if (a[299999] != 3) { return(3); }
    return(0);
}
