// Narrow-element arrays must stay inside their own stack region: neighbouring
// locals are not corrupted, and elements are laid out in ascending addresses.
// EXPECT-EXIT: 0
// EXPECT-STDOUT: 5
// EXPECT-STDOUT: 6
// EXPECT-STDOUT: 77
// EXPECT-STDOUT: 1234567890123
// EXPECT-STDOUT: 11
// EXPECT-STDOUT: 22
// EXPECT-STDOUT: 33
// EXPECT-STDOUT: 6
// EXPECT-STDOUT: 6
// EXPECT-STDOUT: 6

function second(p: i32*) -> i32 {
    return *(p + 1);
}

function main() {
    var before: i64 = 77;
    var a: i32[2];
    var after: i64 = 1234567890123;
    a[0] = 5;
    a[1] = 6;
    print(a[0]);
    print(a[1]);
    print(before);
    print(after);

    var c: u8[3];
    var guard: i64 = 6;
    c[0] = 11;
    c[1] = 22;
    c[2] = 33;
    print(c[0]);
    print(c[1]);
    print(c[2]);
    print(guard);

    // Pointer arithmetic on a decayed array walks forward through memory.
    print(second(a));
    var p: i32* = a;
    print(*(p + 1));
    return(0);
}
