// bitwise AND, OR, XOR, shift, NOT
// a == 2 (110 & 011 = 010)
// b == 7 (110 | 011 = 111)
// c == 5 (110 ^ 011 = 101)
// d == 8
// e == 4
// f == -1 (all bits inverted)
// g == 0

function main() {
    var a = 6 & 3;
    var b = 6 | 3;
    var c = 6 ^ 3;
    var d = 1 << 3;
    var e = 16 >> 2;
    var f = ~0;
    var g = ~(-1);
    return(a + b + c + d + e);
}
