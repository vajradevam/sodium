function main() {
    var a: f64 = 7.5;
    var b: f64 = 2.5;
    print("%f %f %f %f", a + b, a - b, a * b, a / b);
    print(-a);
    print(-(a - b));
    print(1.0 / 3.0);
    print(2.0 + 3.0 * 4.0);
    var i: i64 = 3;
    print(i * 1.5);
    print(10 / 4.0);
    var z: f64 = 0.0;
    print(-z);
    var s: f64 = 1e3;
    print(s + 2.5e-1);
    return(0);
}
