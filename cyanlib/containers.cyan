// ──────────────────────────────────────────────────────────────────────────────
// containers.cyan — dynamic containers written in Cyan.
//
// Include it with:
//     #include "containers.cyan"
//
// All containers are passed by pointer: init, then push/get/set, then free.
// Growth doubles capacity, so a run of pushes is amortised O(1) each.
// ──────────────────────────────────────────────────────────────────────────────

#pragma once

#include "string.cyan"

// ── Vec: growable array of i64 ───────────────────────────────────────────────

struct Vec {
    var data: i64*;
    var len: i64;
    var cap: i64;
};

function vec_init(v: Vec*, cap: i64) {
    var c = cap;
    if (c < 1) { c = 4; }
    v->data = malloc(c * 8) as i64*;
    v->len = 0;
    v->cap = c;
    return(0);
}

function vec_push(v: Vec*, x: i64) {
    if (v->len == v->cap) {
        var nc = v->cap * 2;
        var nd = malloc(nc * 8) as i64*;
        var i = 0;
        while (i < v->len) {
            *(nd + i) = *(v->data + i);
            i = i + 1;
        }
        free(v->data);
        v->data = nd;
        v->cap = nc;
    }
    *(v->data + v->len) = x;
    v->len = v->len + 1;
    return(0);
}

function vec_get(v: Vec*, i: i64) -> i64 {
    return(*(v->data + i));
}

function vec_set(v: Vec*, i: i64, x: i64) {
    *(v->data + i) = x;
    return(0);
}

function vec_len(v: Vec*) -> i64 {
    return(v->len);
}

// Stable checksum used by the property tests: sum(data[i] * 31^(n-1-i)).
function vec_checksum(v: Vec*) -> i64 {
    var s = 0;
    var i = 0;
    while (i < v->len) {
        s = s * 31 + *(v->data + i);
        i = i + 1;
    }
    return(s);
}

function vec_free(v: Vec*) {
    free(v->data);
    v->data = null;
    v->len = 0;
    v->cap = 0;
    return(0);
}

// ── Str: growable byte-string builder ────────────────────────────────────────

struct Str {
    var data: u8*;
    var len: i64;
    var cap: i64;
};

function str_init(s: Str*, cap: i64) {
    var c = cap;
    if (c < 1) { c = 8; }
    s->data = malloc(c);
    s->len = 0;
    s->cap = c;
    return(0);
}

function str_grow(s: Str*) {
    var nc = s->cap * 2;
    var nd = malloc(nc);
    var i = 0;
    while (i < s->len) {
        *(nd + i) = *(s->data + i);
        i = i + 1;
    }
    free(s->data);
    s->data = nd;
    s->cap = nc;
    return(0);
}

function str_push(s: Str*, c: u8) {
    if (s->len + 1 >= s->cap) { str_grow(s); }
    *(s->data + s->len) = c;
    s->len = s->len + 1;
    return(0);
}

function str_append(s: Str*, p: u8*) {
    var i = 0;
    while (*(p + i) != 0) {
        str_push(s, *(p + i));
        i = i + 1;
    }
    return(0);
}

// Finalise in place: append the terminator and return the buffer. The Str
// still owns that buffer, so release it with str_free, not free.
function str_build(s: Str*) -> u8* {
    if (s->len + 1 >= s->cap) { str_grow(s); }
    *(s->data + s->len) = 0;
    return(s->data);
}

function str_len(s: Str*) -> i64 {
    return(s->len);
}

function str_free(s: Str*) {
    free(s->data);
    s->data = null;
    s->len = 0;
    s->cap = 0;
    return(0);
}

// ── HashMap: open-addressed string -> i64 map ────────────────────────────────

// Slot state: 0 = empty, 1 = occupied, 2 = tombstone (deleted).
struct Slot {
    var key: u8*;
    var value: i64;
    var state: i64;
};

struct Map {
    var slots: Slot*;
    var cap: i64;
    var count: i64;
};

function map_hash(s: u8*) -> i64 {
    var h = 5381;
    var i = 0;
    while (*(s + i) != 0) {
        h = h * 33 + *(s + i);
        i = i + 1;
    }
    return(h & 0x7fffffff);
}

function map_init(m: Map*, cap: i64) {
    var c = 8;
    while (c < cap) { c = c * 2; }
    m->slots = malloc(c * 24) as Slot*;
    m->cap = c;
    m->count = 0;
    var i = 0;
    while (i < c) {
        var s = m->slots + i;
        s->key = null;
        s->value = 0;
        s->state = 0;
        i = i + 1;
    }
    return(0);
}

// Linear probe: an empty slot ends the probe but a remembered tombstone is
// returned first so it can be reused.
function map_find(m: Map*, key: u8*) -> Slot* {
    var mask = m->cap - 1;
    var i = map_hash(key) & mask;
    var dead: Slot* = null;
    var probes = 0;
    while (probes < m->cap) {
        var s = m->slots + i;
        if (s->state == 0) {
            if (dead != null) { return(dead); }
            return(s);
        }
        if (s->state == 2) {
            if (dead == null) { dead = s; }
        } else {
            if (strcmp(s->key, key) == 0) { return(s); }
        }
        i = (i + 1) & mask;
        probes = probes + 1;
    }
    return(dead);
}

function map_grow(m: Map*) {
    var old = m->slots;
    var old_cap = m->cap;
    m->cap = old_cap * 2;
    m->slots = malloc(m->cap * 24) as Slot*;
    var i = 0;
    while (i < m->cap) {
        var s = m->slots + i;
        s->key = null;
        s->value = 0;
        s->state = 0;
        i = i + 1;
    }
    i = 0;
    while (i < old_cap) {
        var s = old + i;
        if (s->state == 1) {
            var t = map_find(m, s->key);
            t->key = s->key;
            t->value = s->value;
            t->state = 1;
        }
        i = i + 1;
    }
    free(old);
    return(0);
}

// Insert or update. Keys are copied into the map. Returns 0, or -1 if the
// table is unexpectedly full.
function map_put(m: Map*, key: u8*, value: i64) -> i64 {
    if ((m->count + 1) * 2 > m->cap) { map_grow(m); }
    var s = map_find(m, key);
    if (s == null) { return(-1); }
    if (s->state != 1) {
        var n = strlen(key);
        var copy = malloc(n + 1);
        memcpy(copy, key, n);
        *(copy + n) = 0;
        s->key = copy;
        m->count = m->count + 1;  // both empty and tombstone slots are new entries
        s->state = 1;
    }
    s->value = value;
    return(0);
}

// Lookups return 0 when the key is absent; use map_contains to disambiguate.
function map_contains(m: Map*, key: u8*) -> i64 {
    var s = map_find(m, key);
    if (s == null || s->state != 1) { return(0); }
    if (strcmp(s->key, key) == 0) { return(1); }
    return(0);
}

function map_get(m: Map*, key: u8*) -> i64 {
    var s = map_find(m, key);
    if (s == null || s->state != 1 || strcmp(s->key, key) != 0) { return(0); }
    return(s->value);
}

// Returns 1 when a key was removed, 0 when it was absent.
function map_remove(m: Map*, key: u8*) -> i64 {
    var s = map_find(m, key);
    if (s == null || s->state != 1 || strcmp(s->key, key) != 0) { return(0); }
    free(s->key);
    s->key = null;
    s->value = 0;
    s->state = 2;
    m->count = m->count - 1;
    return(1);
}

function map_count(m: Map*) -> i64 {
    return(m->count);
}

// Order-independent checksum over the live entries, used by property tests.
function map_checksum(m: Map*) -> i64 {
    var sum = 0;
    var i = 0;
    while (i < m->cap) {
        var s = m->slots + i;
        if (s->state == 1) {
            sum = sum + (map_hash(s->key) & 0xffff) + s->value;
        }
        i = i + 1;
    }
    return(sum);
}

function map_free(m: Map*) {
    var i = 0;
    while (i < m->cap) {
        var s = m->slots + i;
        if (s->state == 1) { free(s->key); }
        i = i + 1;
    }
    free(m->slots);
    m->slots = null;
    m->cap = 0;
    m->count = 0;
    return(0);
}
