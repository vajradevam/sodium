struct Pair { var a: i64; var b: i64; };

function make(a: i64, b: i64) -> Pair {
    var p: Pair = { .a = a, .b = b };
    return p;
}

function weigh(p: Pair) -> i64 { return p.a * 100 + p.b; }

function main() {
    var v1 = 1;
    var v2 = 2;
    var v3 = 3;
    var v4 = 4;
    var v5 = 5;
    var v6 = 6;
    var v7 = 7;
    var v8 = 8;
    var v9 = 9;
    var v10 = 10;
    var v11 = 11;
    var v12 = 12;
    // Everything below is live while the nested struct calls run.
    var total = v1 + (v2 + (v3 + (v4 + (v5 + (v6 + (v7 + (v8 + (v9 + (v10 + (v11 + (v12 + weigh(make(20, 1)))))))))))));
    print(weigh(make(23, 99)));
    print(total);
    return(0);
}
