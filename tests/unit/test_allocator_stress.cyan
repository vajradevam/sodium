function main() {
    var p8   = malloc(8);
    var p16  = malloc(16);
    var p24  = malloc(24);
    var p40  = malloc(40);
    var p56  = malloc(56);
    var p88  = malloc(88);
    var p120 = malloc(120);
    var p184 = malloc(184);
    var p248 = malloc(248);
    var p376 = malloc(376);
    var p504 = malloc(504);
    var p760 = malloc(760);
    *p8   = 17;
    *p16  = 34;
    *p24  = 51;
    *p40  = 68;
    *p56  = 85;
    *p88  = 102;
    *p120 = 119;
    *p184 = 136;
    *p248 = 153;
    *p376 = 170;
    *p504 = 187;
    *p760 = 204;
    var ok = 1;
    if (*p8   != 17)  { ok = 0; }
    if (*p16  != 34)  { ok = 0; }
    if (*p24  != 51)  { ok = 0; }
    if (*p40  != 68)  { ok = 0; }
    if (*p56  != 85)  { ok = 0; }
    if (*p88  != 102) { ok = 0; }
    if (*p120 != 119) { ok = 0; }
    if (*p184 != 136) { ok = 0; }
    if (*p248 != 153) { ok = 0; }
    if (*p376 != 170) { ok = 0; }
    if (*p504 != 187) { ok = 0; }
    if (*p760 != 204) { ok = 0; }
    free(p16);
    free(p88);
    free(p376);
    var r1 = malloc(16);
    var r2 = malloc(88);
    var r3 = malloc(376);
    *r1 = 205;
    *r2 = 206;
    *r3 = 207;
    if (*r1 != 205) { ok = 0; }
    if (*r2 != 206) { ok = 0; }
    if (*r3 != 207) { ok = 0; }
    var big1 = malloc(3000);
    var big2 = malloc(10000);
    *big1 = 210;
    *big2 = 220;
    if (*big1 != 210)  { ok = 0; }
    if (*big2 != 220) { ok = 0; }
    free(big1);
    free(big2);
    free(0);
    var z = malloc(0);
    var many[50];
    var i = 0;
    while (i < 50) {
        many[i] = malloc(8);
        *many[i] = i * 2 + 1;
        i = i + 1;
    }
    i = 0;
    while (i < 50) {
        if (*many[i] != i * 2 + 1) { ok = 0; }
        i = i + 1;
    }
    i = 0;
    while (i < 50) {
        free(many[i]);
        i = i + 1;
    }
    i = 0;
    while (i < 50) {
        many[i] = malloc(8);
        *many[i] = i * 5;
        i = i + 1;
    }
    i = 0;
    while (i < 50) {
        if (*many[i] != i * 5) { ok = 0; }
        i = i + 1;
    }
    i = 0;
    while (i < 25) {
        free(many[i]);
        i = i + 1;
    }
    i = 0;
    while (i < 25) {
        many[i] = malloc(8);
        *many[i] = i * 3 + 10;
        i = i + 1;
    }
    i = 0;
    while (i < 25) {
        if (*many[i] != i * 3 + 10) { ok = 0; }
        i = i + 1;
    }
    var a = malloc(8);
    var b = malloc(8);
    *a = 42;
    *b = 99;
    if (*a != 42) { ok = 0; }
    if (*b != 99) { ok = 0; }
    *a = 7;
    if (*b != 99) { ok = 0; }
    var c0 = malloc(8);
    *c0 = 255;
    if (*c0 != 255) { ok = 0; }
    var tiny = malloc(1);
    *tiny = 42;
    if (*tiny != 42) { ok = 0; }
    return(ok);
}
