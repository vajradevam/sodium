// Test struct inside function
function test_struct() {
    var inner: Point;
    inner.x = 4;
    inner.y = 6;
    return(inner.x + inner.y);
}


// Final result: small enough to fit in exit code

function main() {
    var p: Point;
    p.x = 5;
    p.y = 3;
    var sum = p.x + p.y;
    print(sum);
    p.x += 2;
    p.y *= 2;
    print(p.x);
    print(p.y);
    var c: Color;
    c.r = 10;
    c.g = 20;
    c.b = 30;
    print(c.r);
    print(c.g);
    print(c.b);
    var result = test_struct();
    print(result);
    return(sum + p.x + p.y + c.r + c.g + c.b + result);
}
