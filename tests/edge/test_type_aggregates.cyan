// T-4: enums (auto-increment, explicit and negative values), C-layout field
// offsets, tables of function pointers and scaled pointer differences.
// EXPECT-EXIT: 0
// EXPECT-STDOUT: 0
// EXPECT-STDOUT: 5
// EXPECT-STDOUT: 6
// EXPECT-STDOUT: -3
// EXPECT-STDOUT: -2
// EXPECT-STDOUT: 11
// EXPECT-STDOUT: 2
// EXPECT-STDOUT: 2
// EXPECT-STDOUT: 4
// EXPECT-STDOUT: 11
// EXPECT-STDOUT: 12
// EXPECT-STDOUT: 2

enum E { A, B = 5, C };
enum F { NEG = -3, NEXT };

struct Layout {
    var a: i8;
    var b: i16;
    var c: i32;
    var d: i64;
};

function add1(x: i64) -> i64 {
    return(x + 1);
}

function add2(x: i64) -> i64 {
    return(x + 2);
}

function main() {
    print(A);
    print(B);
    print(C);
    print(NEG);
    print(NEXT);

    var table: fn(i64) -> i64[2];
    table[0] = &add1;
    table[1] = &add2;
    print(table[0](10));

    var s: Layout;
    print(&s.b - &s.a);
    print(&s.c - &s.b);
    print(&s.d - &s.c);
    print(table[0](10));
    print(table[1](10));

    var arr: i64[4];
    arr[0] = 10;
    arr[1] = 20;
    arr[2] = 30;
    arr[3] = 40;
    print(&arr[3] - &arr[1]);
    return(0);
}
