// C-interop (D-038): a gcc-compiled C `main` calls these Cyan functions with float arguments
// and results and checks every result. scripts/test_abi_interop.sh weakens this file's `main`
// so the C one wins; run on its own, this program just exits 0.
// SKIP-TEST: part of scripts/test_abi_interop.sh (needs the C object)

function add(a: f64, b: f64) -> f64 { return a + b; }
function scale(x: f32, k: f64) -> f32 { return x * k as f32; }
function mix(a: i64, x: f64, b: i64, y: f32, c: i64) -> f64 {
    return a + x * 10.0 + b * 100.0 + y * 1000.0 + c * 10000.0;
}
function nine(a: f64, b: f64, c: f64, d: f64, e: f64, f: f64, g: f64, h: f64, i: f64) -> f64 {
    return a + b * 2.0 + c * 3.0 + d * 4.0 + e * 5.0 + f * 6.0 + g * 7.0 + h * 8.0 + i * 9.0;
}
function many(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64, h: i64, x: f64, y: f64, z: f64) -> f64 {
    return a + b * 2 + c * 3 + d * 4 + e * 5 + f * 6 + g * 7 + h * 8 + x + y * 2.0 + z * 3.0;
}
function twelve(d0: f64, d1: f64, d2: f64, d3: f64, d4: f64, d5: f64, d6: f64, d7: f64,
                d8: f64, d9: f64, d10: f64, d11: f64, n: i64, s: f32) -> f64 {
    return d0 + d1 + d2 + d3 + d4 + d5 + d6 + d7 + d8 * 2.0 + d9 * 3.0 + d10 * 4.0 + d11 * 5.0 + n + s;
}
function less(a: f64, b: f64) -> i64 { return a < b; }
function trunc_to_int(x: f64) -> i64 { return x as i64; }
function from_int(x: i64) -> f64 { return x; }
function narrow(x: f64) -> f32 { return x as f32; }
function widen(x: f32) -> f64 { return x; }
function relay(x: f64) -> f64 { return add(x, 1.0) * 2.0; }

function main() { return(0); }
