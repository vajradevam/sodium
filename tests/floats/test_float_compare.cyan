// EXPECT-EXIT: 0
// EXPECT-STDOUT: 1 1 0 0 0 1
// EXPECT-STDOUT: 0 1 0 1 1 0
// EXPECT-STDOUT: 0 0 0 0 0 1
// EXPECT-STDOUT: 0 0
// EXPECT-STDOUT: inf
// EXPECT-STDOUT: -inf
// EXPECT-STDOUT: nan
// EXPECT-STDOUT: 1 1
// EXPECT-STDOUT: 1 1
// EXPECT-STDOUT: branch
// EXPECT-STDOUT: 6
function main() {
    var x: f64 = 1.5;
    var y: f64 = 2.5;
    print("%d %d %d %d %d %d", x < y, x <= y, x > y, x >= y, x == y, x != y);
    print("%d %d %d %d %d %d", x < x, x <= x, x > x, x >= x, x == x, x != x);
    var zero: f64 = 0.0;
    var nan: f64 = zero / zero;
    print("%d %d %d %d %d %d", nan < y, nan <= y, nan > y, nan >= y, nan == nan, nan != nan);
    print("%d %d", y < nan, y == nan);
    var inf: f64 = 1.0 / zero;
    print(inf);
    print(0.0 - inf);
    print(nan);
    print("%d %d", inf > 1e308, 0 - inf < 0 - 1e308);
    var i: i64 = 2;
    print("%d %d", i < y, i == 2.0);
    if (x < y) { print("branch"); }
    var n: i64 = 0;
    while (x < 10.0) { x = x + 1.5; n = n + 1; }
    print(n);
    return(0);
}
