// EXPECT-EXIT: 50
// EXPECT-STDOUT: 10
// EXPECT-STDOUT: 20
// EXPECT-STDOUT: 30

// Test: address-of struct fields
struct Point {
    var x;
    var y;
};

function main() {
    var p: Point;
    p.x = 10;
    p.y = 20;
    var px = &p.x;
    var py = &p.y;
    print(*px);
    print(*py);
    *px = 30;
    print(p.x);
    return(p.x + *py);
}
