// BF-010 (fixed): u64 arithmetic and comparisons must be unsigned. With all bits set,
// C gives (u>>1)==2^63-1, u/2==2^63-1 and u<1 false. Cyan applies signed i64
// semantics and gives all-ones, 0 and true.
// EXPECT-EXIT: 0
// EXPECT-STDOUT: 9223372036854775807
// EXPECT-STDOUT: 9223372036854775807
// EXPECT-STDOUT: 0

function main() {
    var u: u64 = 0 as u64 - 1;
    print("%u", u >> 1);
    print("%u", u / 2);
    print(u < 1);
    return(0);
}
