// EXPECT-EXIT: 0
// EXPECT-STDOUT: 12.500000
// EXPECT-STDOUT: 12.000000
// EXPECT-STDOUT: 36.000000
// EXPECT-STDOUT: 9.000000
// EXPECT-STDOUT: 10.000000
// EXPECT-STDOUT: 5.000000
// EXPECT-STDOUT: 1.500000
// EXPECT-STDOUT: 1.000000
// EXPECT-STDOUT: 3.000000
// EXPECT-STDOUT: 0.500000
function main() {
    var x: f64 = 10.0;
    x += 2.5;
    print(x);
    x -= 0.5;
    print(x);
    x *= 3.0;
    print(x);
    x /= 4.0;
    print(x);
    x += 1;
    print(x);
    var y = 2.5;
    y = y * 2;
    print(y);
    var f: f32 = 1.0f;
    f += 0.5;
    print(f);
    var sum: f64 = 0.0;
    var i: i64 = 0;
    while (i < 10) { sum += 0.1; i = i + 1; }
    print(sum);
    var c: f64 = 3.0;
    var t: f64 = i > 5 ? c : 0.5;
    print(t);
    var u: f64 = i < 5 ? c : 0.5;
    print(u);
    return(0);
}
