// EXPECT-STDOUT: -7.500000
// EXPECT-STDOUT: -5.000000
// EXPECT-STDOUT: 0.333333
// EXPECT-STDOUT: 14.000000
// EXPECT-STDOUT: 4.500000
// EXPECT-STDOUT: 2.500000
// EXPECT-STDOUT: -0.000000
